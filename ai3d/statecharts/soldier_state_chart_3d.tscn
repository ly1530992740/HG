[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://ai3d/statecharts/soldier_state_chart_3d.gd" id="1_controller"]
[ext_resource type="Script" path="res://addons/godot_state_charts/state_chart.gd" id="2_chart"]
[ext_resource type="Script" path="res://addons/godot_state_charts/compound_state.gd" id="3_compound"]
[ext_resource type="Script" path="res://addons/godot_state_charts/atomic_state.gd" id="4_atomic"]
[ext_resource type="Script" path="res://addons/godot_state_charts/transition.gd" id="5_transition"]

[node name="SoldierStateChart" type="Node"]
script = ExtResource("1_controller")

[node name="StateChart" type="Node" parent="."]
script = ExtResource("2_chart")

[node name="SoldierExecution" type="Node" parent="StateChart"]
script = ExtResource("3_compound")
initial_state = NodePath("IdleSecurity")

[node name="IdleSecurity" type="Node" parent="StateChart/SoldierExecution"]
script = ExtResource("4_atomic")

[node name="DirectiveReceived" type="Node" parent="StateChart/SoldierExecution/IdleSecurity"]
script = ExtResource("5_transition")
to = NodePath("../../ExecuteOrder")
event = &"directive_received"

[node name="DangerDetected" type="Node" parent="StateChart/SoldierExecution/IdleSecurity"]
script = ExtResource("5_transition")
to = NodePath("../../SurvivalOverride")
event = &"danger_detected"

[node name="ActorDied" type="Node" parent="StateChart/SoldierExecution/IdleSecurity"]
script = ExtResource("5_transition")
to = NodePath("../../Dead")
event = &"actor_died"

[node name="ExecuteOrder" type="Node" parent="StateChart/SoldierExecution"]
script = ExtResource("4_atomic")

[node name="DirectiveCleared" type="Node" parent="StateChart/SoldierExecution/ExecuteOrder"]
script = ExtResource("5_transition")
to = NodePath("../../IdleSecurity")
event = &"directive_cleared"

[node name="DangerDetected" type="Node" parent="StateChart/SoldierExecution/ExecuteOrder"]
script = ExtResource("5_transition")
to = NodePath("../../SurvivalOverride")
event = &"danger_detected"

[node name="ActorDied" type="Node" parent="StateChart/SoldierExecution/ExecuteOrder"]
script = ExtResource("5_transition")
to = NodePath("../../Dead")
event = &"actor_died"

[node name="SurvivalOverride" type="Node" parent="StateChart/SoldierExecution"]
script = ExtResource("4_atomic")

[node name="DangerClearedWithOrder" type="Node" parent="StateChart/SoldierExecution/SurvivalOverride"]
script = ExtResource("5_transition")
to = NodePath("../../ExecuteOrder")
event = &"danger_cleared_with_order"

[node name="DangerClearedWithoutOrder" type="Node" parent="StateChart/SoldierExecution/SurvivalOverride"]
script = ExtResource("5_transition")
to = NodePath("../../IdleSecurity")
event = &"danger_cleared_without_order"

[node name="ActorDied" type="Node" parent="StateChart/SoldierExecution/SurvivalOverride"]
script = ExtResource("5_transition")
to = NodePath("../../Dead")
event = &"actor_died"

[node name="Dead" type="Node" parent="StateChart/SoldierExecution"]
script = ExtResource("4_atomic")

[connection signal="state_entered" from="StateChart/SoldierExecution/IdleSecurity" to="." method="_on_root_state_entered" binds=[3]]
[connection signal="state_exited" from="StateChart/SoldierExecution/IdleSecurity" to="." method="_on_root_state_exited" binds=[3]]
